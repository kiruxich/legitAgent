{
  "name": "legitagent-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && node --test scripts/benchmark-corpus.test.mjs",
    "benchmark": "pnpm --filter @legit-agent/core build && node scripts/benchmark.mjs",
    "legal:check": "pnpm --filter @legit-agent/core build && node scripts/check-legal-drift.mjs --offline",
    "legal:drift": "pnpm --filter @legit-agent/core build && node scripts/check-legal-drift.mjs",
    "release:check": "node scripts/release-check.mjs",
    "catalog": "pnpm --filter @legit-agent/core build && node scripts/generate-catalog.mjs",
    "fetch-law": "node scripts/fetch-pravo.mjs"
  }
}
